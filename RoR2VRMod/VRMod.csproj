<Project Sdk="Microsoft.NET.Sdk">

  <!-- The mod itself. Shared settings and package versions are in ../Directory.Build.props.
       Run build-tools/ci/fetch-refs.sh once before the first build: it fills refs/lib/ with the
       libraries that are neither in this repository nor on NuGet. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>VRMod</AssemblyName>
    <RootNamespace>VRMod</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="$(BepInExVersion)" />
    <PackageReference Include="UnityEngine.Modules" Version="$(UnityModulesVersion)" IncludeAssets="compile" PrivateAssets="all" />
    <!-- Stripped reference copies of the game's assemblies. The mod uses private game members
         (it skips IL verification at runtime), so they are made public for compiling. -->
    <PackageReference Include="RiskOfRain2.GameLibs" Version="$(GameLibsVersion)" Publicize="true" IncludeAssets="compile" PrivateAssets="all" />
    <!-- Referenced by path below: the package keeps its DLL in the root of lib/. -->
    <PackageReference Include="MMHOOK.RoR2" Version="$(MMHookVersion)" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="$(PublicizerVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VREnabler\VRPatcher.csproj" Private="false" />
    <Reference Include="$(PkgMMHOOK_RoR2)/lib/**/MMHOOK_RoR2.dll" Private="false" />
    <!-- XR packages, haptics SDKs and the reference-only builds from fetch-refs.sh. -->
    <Reference Include="$(RefsLibDir)*.dll" Publicize="true" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**/Editor/**;**/Tests/**" />
    <!-- Raw manifest resource under the exact name Properties/Resources.Designer.cs loads. -->
    <EmbeddedResource Remove="Properties\Resources.resx" />
    <EmbeddedResource Include="Properties\vrmodassets" LogicalName="VRMod.Properties.vrmodassets" />
  </ItemGroup>

  <Target Name="CheckFetchedReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RefsLibDir)Unity.XR.OpenXR.dll')" Text="refs/lib/ is empty. Run build-tools/ci/fetch-refs.sh first (see build-tools/ci/README.md)." />
  </Target>

</Project>
