<Project Sdk="Microsoft.NET.Sdk">

  <!-- Preloader patcher: copies the OpenXR native files into the game and enables XR at startup.
       Shared settings and package versions are in ../Directory.Build.props. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>VRPatcher</AssemblyName>
    <RootNamespace>VRPatcher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="$(BepInExVersion)" />
    <PackageReference Include="UnityEngine.Modules" Version="$(UnityModulesVersion)" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <!-- Raw manifest resources under the exact names Properties/Resources.Designer.cs loads. -->
  <ItemGroup>
    <EmbeddedResource Remove="Properties\Resources.resx" />
    <EmbeddedResource Include="Plugins\openxr_loader.dll" LogicalName="VRPatcher.Plugins.openxr_loader.dll" />
    <EmbeddedResource Include="Plugins\UnityOpenXR.dll" LogicalName="VRPatcher.Plugins.UnityOpenXR.dll" />
    <EmbeddedResource Include="Dependencies\UnitySubsystemsManifest.json" LogicalName="VRPatcher.Dependencies.UnitySubsystemsManifest.json" />
  </ItemGroup>

</Project>
